{
  "name": "magic-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p packages/plugin/tsconfig.main.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "fake-plugin": "node --import tsx scripts/fake-plugin-client.ts",
    "smoke:figma": "node --import tsx scripts/figma-smoke-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.48.0",
    "prettier": "^3.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.6",
    "esbuild": "^0.25.12",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  }
}
